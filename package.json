{
  "name": "droper",
  "productName": "Droper",
  "version": "0.3.4",
  "description": "Cross-platform drag & drop shelf for macOS and Windows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phoenix124/droper.git"
  },
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "icon": "node scripts/gen-icon.mjs",
    "postinstall": "node scripts/build-native.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "build": {
    "appId": "com.droper.app",
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/uiohook-napi/build/**",
      "!node_modules/uiohook-napi/{src,libuiohook}/**",
      "native/build/Release/droper_native.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAccessibilityUsageDescription": "Droper watches mouse drags to show its shelf when you start dragging."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "native/build/Release/droper_native.node"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "buildUniversalInstaller": false
    },
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Droper",
        "schemes": [
          "droper"
        ]
      }
    ],
    "electronLanguages": [
      "en",
      "en-US"
    ],
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "node-gyp": "13.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
